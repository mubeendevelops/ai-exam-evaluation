# ──────────────────────────────────────────────
# PostgreSQL connection (used by core/db.py)
# ──────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=ai_evaluation
PGUSER=postgres
PGPASSWORD=

# ──────────────────────────────────────────────
# MinIO / S3-compatible object storage (used by core/storage.py)
# Only required when running with --storage minio.
# Can be left blank/unset for --storage dummy (the default).
# ──────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai_evaluation

# ──────────────────────────────────────────────
# Groq LLM (used by reword_question.py and future generation jobs)
# Free tier, no credit card, ~14,400 req/day / 30 req/min.
# Get a key at https://console.groq.com (API Keys → Create API Key).
# ──────────────────────────────────────────────
GROQ_API_KEY=gsk_your_actual_key_here
# GROQ_MODEL=qwen/qwen3.6-27b   # default if unset

# ──────────────────────────────────────────────
# API layer (used by api/settings.py). All optional — the defaults below are
# what you get if unset.
#
# NOTE ON PGUSER ABOVE: Postgres exempts superusers and BYPASSRLS roles from
# row-level security, so with PGUSER=postgres the tenant policies in
# migration 003 are inert and multi-tenant isolation is NOT enforced. Fine for
# local dev; point PGUSER at a non-superuser application role before anything
# real. See api/README.md.
# ──────────────────────────────────────────────
API_ENV=development
# Comma-separated allowed CORS origins. "*" is development-only.
CORS_ORIGINS=*
# Registers GET /api/v1/_debug/whoami. Defaults to true when API_ENV is
# "development", false otherwise. Set explicitly to override.
# ENABLE_DEBUG_ENDPOINTS=true
# Where POST /api/v1/upload writes booklets: "dummy" (deterministic placeholder
# ref, no MinIO, no boto3 — same default as the CLI scripts' --storage) or
# "minio" (real upload, needs the MINIO_* values above).
STORAGE_MODE=dummy
# Hard cap on an uploaded booklet, in bytes (default 50 MB). Enforced while
# streaming, not from the client-supplied Content-Length header.
# MAX_UPLOAD_BYTES=52428800
