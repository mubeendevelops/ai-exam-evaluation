# ──────────────────────────────────────────────
# PostgreSQL connection (used by db.py)
# ──────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=ai_evaluation
PGUSER=postgres
PGPASSWORD=

# ──────────────────────────────────────────────
# MinIO / S3-compatible object storage (used by storage.py)
# Only required when running with --storage minio.
# Can be left blank/unset for --storage dummy (the default).
# ──────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai_evaluation

# ── LLM provider (used by reword_question.py and future generation jobs) ──
# Chosen: Groq — free tier, no credit card, ~14,400 req/day / 30 req/min.
# Get a key at https://console.groq.com (API Keys → Create API Key).
LLM_PROVIDER=groq
GROQ_API_KEY=gsk_your_actual_key_here
# GROQ_MODEL=llama-3.3-70b-versatile   # default if unset

# ── Other LLM providers (not in use — left here for reference/switching) ──
# LLM_PROVIDER=ollama                  # free, local, no signup — needs `ollama serve` running
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1

# LLM_PROVIDER=gemini                  # free tier, no credit card, ~1,500 req/day
# GEMINI_API_KEY=your_gemini_key_here
# GEMINI_MODEL=gemini-2.5-flash
