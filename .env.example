# ──────────────────────────────────────────────
# PostgreSQL connection (used by core/db.py)
#
# ⚠ PGUSER=postgres DISABLES ROW-LEVEL SECURITY ENTIRELY. Postgres exempts
#   SUPERUSER and BYPASSRLS roles from RLS, and the FORCE ROW LEVEL SECURITY in
#   migrations 003/014/015 closes the table-OWNER loophole, not that one. Under
#   a superuser every tenant_isolation policy is inert and two different
#   app.current_college_id values see the SAME ROWS — silently, with nothing in
#   the log. Point PGUSER at the non-superuser application role created by
#   migrations/016_application_role.sql instead (that is the default below).
#
#   tests/test_api/test_rls_isolation.py::test_rls_policies_isolate_tenants and
#   test_tenant_context.py::test_tenant_connection_is_actually_rls_scoped SKIP,
#   loudly, whenever PGUSER bypasses RLS — a skip there means this is misset.
# ──────────────────────────────────────────────
PGHOST=localhost
PGPORT=5432
PGDATABASE=ai_evaluation
PGUSER=ai_eval_app
PGPASSWORD=

# ──────────────────────────────────────────────
# The application role, for migrations/016_application_role.sql.
#
# The migration takes the password from THIS environment rather than from a
# literal in the .sql file: that file is in git, so a literal would be a
# committed credential, and re-running the migration would silently reset the
# password back to it.
#
#     set -a && source .env && set +a
#     psql -v ON_ERROR_STOP=1 -f migrations/016_application_role.sql
#
# APP_DB_USER must match PGUSER above; APP_DB_PASSWORD must match PGPASSWORD.
# ──────────────────────────────────────────────
APP_DB_USER=ai_eval_app
APP_DB_PASSWORD=

# ──────────────────────────────────────────────
# Operator/owner role — migrations, backups, reset+seed. NOT used by the app.
#
# scripts/reset_and_seed_db.sh runs pg_dump, TRUNCATE and the seed as this
# role, not as PGUSER. The application role deliberately has no TRUNCATE grant
# (one TRUNCATE ignores RLS and would empty every tenant at once), and a
# pg_dump taken as the application role would be SILENTLY EMPTY for all nine
# RLS-protected tables — a backup that restores a database with no students.
# ──────────────────────────────────────────────
PGADMIN_USER=postgres
PGADMIN_PASSWORD=

# ──────────────────────────────────────────────
# MinIO / S3-compatible object storage (used by core/storage.py)
# Only required when running with --storage minio.
# Can be left blank/unset for --storage dummy (the default).
# ──────────────────────────────────────────────
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=ai_evaluation

# ──────────────────────────────────────────────
# Groq LLM (used by reword_question.py and future generation jobs)
# Free tier, no credit card, ~14,400 req/day / 30 req/min.
# Get a key at https://console.groq.com (API Keys → Create API Key).
# ──────────────────────────────────────────────
GROQ_API_KEY=gsk_your_actual_key_here
# GROQ_MODEL=qwen/qwen3.6-27b   # default if unset

# ──────────────────────────────────────────────
# API layer (used by api/settings.py). All optional — the defaults below are
# what you get if unset.
# ──────────────────────────────────────────────
API_ENV=development
# Comma-separated allowed CORS origins. Unset (the default) means:
#   * API_ENV=development -> the local Vite dev server origin
#     (http://localhost:5173).
#   * anything else        -> the app REFUSES TO START. There is no
#     permissive fallback outside development (Hardening pass 2026-09-06) —
#     an unconfigured CORS policy used to silently default to "*", which is
#     the wrong way for a deployment to fail. Set this explicitly (to "*" if
#     that really is the intended policy) for anything but local dev.
# CORS_ORIGINS=https://your-frontend.example
# Gates the `stub`/`stub_llm` request fields on POST /evaluate and
# POST /questions/generate, both of which write FABRICATED data into real
# tables. (It no longer registers any endpoint — the whoami probe was deleted;
# see api/main.py.) Defaults to true when API_ENV is "development", false
# otherwise. Set explicitly to override.
# ENABLE_DEBUG_ENDPOINTS=true
# Where POST /api/v1/upload writes booklets: "dummy" (no MinIO, no boto3 — same
# default as the CLI scripts' --storage) or "minio" (real upload, needs the
# MINIO_* values above).
#
# NOTE for "dummy": the booklet_ingest job reads the uploaded PDF back, in the
# worker process, minutes after the request stored it — so the API's upload
# path uses core/storage.py::dummy_store(), which KEEPS the bytes under
# DUMMY_STORAGE_ROOT, rather than dummy_upload(), which returns a placeholder
# ref with no file behind it. The API and the worker must therefore agree on
# both of these values, or ingestion fails with "No local bytes for dummy ref".
STORAGE_MODE=dummy
# Where dummy mode keeps those bytes. Defaults to
# <system temp dir>/ai-eval-dummy-storage.
# DUMMY_STORAGE_ROOT=/tmp/ai-eval-dummy-storage
# Hard cap on an uploaded booklet, in bytes (default 50 MB). Enforced while
# streaming, not from the client-supplied Content-Length header.
# MAX_UPLOAD_BYTES=52428800

# ──────────────────────────────────────────────
# Authentication (api/deps/identity.py, api/routers/auth.py).
#
# JWT_SECRET signs the access token. There is deliberately NO committed
# default: a fallback in this file would be a signing key every checkout of the
# repo shares, and anyone holding it can mint a token for any college.
#
#   * unset + API_ENV=development -> a key is generated PER PROCESS, with a
#     warning. Usable on a bare checkout; every restart invalidates outstanding
#     access tokens, and two uvicorn workers will not agree on it.
#   * unset + anything else       -> the app REFUSES TO START. A per-process
#     key across workers means intermittent 401s under load, which is a worse
#     day than a refused boot.
#
# Generate one with:
#     python -c 'import secrets; print(secrets.token_urlsafe(48))'
# ──────────────────────────────────────────────
JWT_SECRET=
# HS256 by default. RS256 becomes worth its key management the day something
# other than this API needs to verify a token (the job worker, a second
# service) — python-jose[cryptography] already supports it.
# JWT_ALGORITHM=HS256
# Access-token lifetime. SHORT on purpose: an access token cannot be revoked
# before it expires (there is no per-request DB lookup to revoke it with), so
# this window IS its blast radius. Revocation lives on the refresh token.
# ACCESS_TOKEN_TTL_MINUTES=15
# How long a client may stay signed in without re-entering a password.
# Revocable at any point inside it (POST /auth/logout).
# REFRESH_TOKEN_TTL_DAYS=14
# POST /auth/login rate limit: attempts per window, counted per client IP and
# per email address, IN PROCESS (no Redis — see api/deps/ratelimit.py for what
# that does and does not buy). Per worker, and reset by a restart.
# LOGIN_RATE_LIMIT_ATTEMPTS=10
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=300

# ──────────────────────────────────────────────
# Per-college API rate limits (api/deps/quota.py). In-process, no Redis —
# same limitation as LOGIN_RATE_LIMIT_* above. Keyed by the caller's college
# (or user id for a platform_admin) — never by IP, never by a body field.
# These bound the endpoints that spend real Groq tokens or real CPU/DB writes
# on every call: POST /evaluate, /questions/generate, /papers/generate,
# /upload. 429 + Retry-After when exceeded.
# EVALUATE_RATE_LIMIT_ATTEMPTS=10
# EVALUATE_RATE_LIMIT_WINDOW_SECONDS=60
# QUESTIONS_GENERATE_RATE_LIMIT_ATTEMPTS=10
# QUESTIONS_GENERATE_RATE_LIMIT_WINDOW_SECONDS=60
# PAPERS_GENERATE_RATE_LIMIT_ATTEMPTS=30
# PAPERS_GENERATE_RATE_LIMIT_WINDOW_SECONDS=60
# UPLOAD_RATE_LIMIT_ATTEMPTS=20
# UPLOAD_RATE_LIMIT_WINDOW_SECONDS=60
# How many of a college's OWN evaluation_jobs may sit 'queued'/'running' at
# once. THIS is what actually protects the shared Groq daily quota
# (~14,400/day) — core/llm.py's token bucket is per-process and cannot see a
# backlog building slowly across many requests over hours; this is read live
# from evaluation_jobs on every POST /evaluate instead.
# MAX_QUEUED_JOBS_PER_COLLEGE=5

# ──────────────────────────────────────────────
# The FIRST platform_admin account, for scripts/bootstrap_platform_admin.py.
# Read from the environment (or a no-echo prompt), never from argv — a password
# on a long-lived process's command line is visible in `ps`. Set it only for
# the duration of that one command; nothing else reads it.
# ──────────────────────────────────────────────
# BOOTSTRAP_ADMIN_PASSWORD=
