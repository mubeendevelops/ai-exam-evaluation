# Copy to .env (`make setup` does this). .env is git-ignored; never commit real secrets.
# Every variable the stack reads is listed here with a safe development default.

# --- Application (read by tarn_adapters.config.Settings; TARN_ prefix) -------------------
TARN_ENV=development                  # development | test | production
TARN_LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
# auto: use CUDA when the GPU and torch are available, otherwise CPU. cpu | cuda to force.
TARN_DEVICE=auto
# --- OCR (P10) -----------------------------------------------------------------------------
# Engines per content class, in tie-break order: paddle, tesseract, trocr (local); textract,
# azure, docai (cloud, used only when enabled below). Missing engines are skipped and logged.
TARN_OCR_ENGINES_PRINT=paddle,tesseract,textract,azure,docai
TARN_OCR_ENGINES_CURSIVE=trocr,paddle,textract,azure,docai
TARN_OCR_ENGINES_NUMERIC=trocr,paddle,tesseract,textract,azure,docai
# Selector S = w*p + alpha*agreement + beta*lexicon fit; a line whose normalised score is
# below the threshold is flagged for the teacher (placeholders until the P11 benchmark).
TARN_OCR_ALPHA=0.5
TARN_OCR_BETA=0.25
TARN_OCR_FLAG_THRESHOLD=0.6
TARN_OCR_ENGINE_TIMEOUT_SECONDS=120
# Read every page as it is and turned 180°; keep the clearly better one.
TARN_OCR_ORIENTATION_CHECK=true
TARN_OCR_ORIENTATION_MARGIN=0.1
TARN_OCR_DETECTION_MODEL=PP-OCRv5_mobile_det   # or PP-OCRv5_server_det (~18x slower on CPU)
TARN_OCR_RECOGNITION_MODEL=PP-OCRv5_server_rec  # or PP-OCRv5_mobile_rec
TARN_OCR_LAYOUT_MODEL=PP-DocLayout-L
TARN_TROCR_MODEL=microsoft/trocr-base-handwritten
TARN_TROCR_BATCH=0                    # 0 = 8 line crops on CUDA, 4 on the CPU
TARN_TROCR_PRECISION=auto             # auto | fp16 | fp32 (auto: the faster on this GPU)
# Sentence embeddings for segmentation (P12); "trigram" = the model-free fallback.
TARN_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Sentence embeddings for scoring (P13): local weights only (`tarn score models fetch`), or "trigram".
TARN_SCORING_EMBEDDING_MODEL=thenlper/gte-small
TARN_MODEL_DIR=../var/models          # model weights (git-ignored); /models in Compose
# TARN_ENGLISH_WORDS=                 # a word list (.txt/.txt.gz); default: the bundled SCOWL list
# Cloud OCR engines (Textract, Azure Read, Document AI) stay off: in development student data
# never leaves this machine (design decision 4). To enable outside production you need all
# three of: TARN_CLOUD_OCR_ENABLED=true, TARN_CLOUD_OCR_ALLOW_IN_DEVELOPMENT=true, and credentials.
TARN_CLOUD_OCR_ENABLED=false
TARN_CLOUD_OCR_ALLOW_IN_DEVELOPMENT=false
TARN_AWS_REGION=ap-south-1            # Textract; credentials from the AWS chain (AWS_PROFILE, ...)
TARN_AZURE_DI_ENDPOINT=
TARN_AZURE_DI_KEY=
# Document AI OCR processor (P20); credentials: Application Default Credentials (the Cloud Run
# service account in production). projects/<p>/locations/<l>/processors/<id>
TARN_DOCAI_PROCESSOR=
# --- LLM scorer (P19): OFF by default -----------------------------------------------------
# A second opinion per rubric criterion from Groq, beside the local scorers. Answer text (never
# the student's name or USN) leaves this machine, so it needs ALL of: the switch below, the
# development allowance, a key, and the college switched on (`tarn tenants llm ID --on
# --operator NAME`). Use synthetic answers: not samples/ (real student data).
TARN_LLM_SCORER_ENABLED=false
TARN_LLM_ALLOW_IN_DEVELOPMENT=false
# DEVELOPMENT ONLY: comma-separated free-tier keys, rotated with a rate limit per key.
# PRODUCTION needs ONE key of a PAID plan (kept in Secret Manager): rotating free accounts to
# dodge rate limits may breach the provider's terms, and production refuses several keys.
GROQ_API_KEYS=
TARN_GROQ_MODEL=openai/gpt-oss-120b
TARN_LLM_TIMEOUT_SECONDS=20
TARN_LLM_MAX_ATTEMPTS=3
TARN_LLM_REQUESTS_PER_MINUTE=30       # per key
TARN_LLM_MAX_WAIT_SECONDS=15
TARN_LLM_MAX_ANSWER_CHARS=6000
TARN_LLM_MAX_OUTPUT_TOKENS=1000      # reasoning models think before the JSON
# Object store (P20): minio (development), gcs (production: Cloud Storage bucket TARN_BLOB_BUCKET,
# Application Default Credentials) or s3 (portability: TARN_BLOB_ENDPOINT=s3.<region>.amazonaws.com,
# TARN_BLOB_SECURE=true, TARN_BLOB_REGION, and empty access/secret keys for an instance role).
TARN_BLOB_BACKEND=minio
TARN_BLOB_REGION=
# Used by processes on the host (make test-integration, `uv run tarn doctor`). Inside Docker
# Compose these are set to the postgres/minio service names by docker-compose.yml.
# Owner role: migrations only (make migrate). Application role tarn_app: everything else; it
# has no superuser or BYPASSRLS, so row-level security applies to it.
TARN_DATABASE_URL=postgresql://tarn:tarn_dev_password@localhost:5432/tarn
TARN_APP_DATABASE_URL=postgresql://tarn_app:tarn_app_dev_password@localhost:5432/tarn
TARN_BLOB_ENDPOINT=localhost:9000
TARN_BLOB_SECURE=false
TARN_BLOB_BUCKET=tarn
TARN_BLOB_ACCESS_KEY=tarn_dev_minio
TARN_BLOB_SECRET_KEY=tarn_dev_minio_password

# --- Identity store and authentication (P4) ---------------------------------------------
# A separate database with its own roles: the owner runs migrations (make migrate); the
# application role tarn_auth (no superuser, no BYPASSRLS) serves sign-in. tarn_app cannot
# connect to it, and tarn_auth cannot connect to the application database.
TARN_IDENTITY_DATABASE_URL=postgresql://tarn:tarn_dev_password@localhost:5432/tarn_identity
TARN_IDENTITY_APP_DATABASE_URL=postgresql://tarn_auth:tarn_auth_dev_password@localhost:5432/tarn_identity
# Password of tarn_auth inside Compose; keep it equal to TARN_IDENTITY_APP_DATABASE_URL's.
TARN_AUTH_DB_PASSWORD=tarn_auth_dev_password
# Envelope encryption: the KMS key that wraps each new tenant's data key.
#   local:<name>  a development file key in TARN_LOCAL_KEY_DIR (created on first use)
#   gcp-kms:projects/<p>/locations/asia-south1/keyRings/<r>/cryptoKeys/<k>  (production)
#   aws-kms:<key id, ARN or alias>  (the portability adapter; needs `uv sync --group cloud-ocr`)
TARN_KMS_KEY_REF=local:tarn-dev
TARN_LOCAL_KEY_DIR=../var/keys
# Secrets: "settings" reads the two values below (development only; production refuses the
# defaults); "gcp" reads Secret Manager secrets tarn-password-pepper and
# tarn-token-signing-key in TARN_GCP_PROJECT.
TARN_SECRETS_BACKEND=settings
TARN_GCP_PROJECT=
TARN_GCP_REGION=asia-south1
TARN_PASSWORD_PEPPER=dev-only-pepper-not-for-production
# Pepper rotation (P21): the earlier pepper(s), comma-separated, accepted until every account
# has signed in once more (sign-in re-hashes with the current pepper). Empty = no rotation.
TARN_PASSWORD_PEPPER_PREVIOUS=
# At least 32 bytes (HS256).
TARN_TOKEN_SIGNING_KEY=dev-only-signing-key-not-for-production
# Rate limits on sign-in, recovery, password reset, invitations and registration (P21), per
# client address and per account, in each API process. Behind a load balancer the client is
# the X-Forwarded-For entry this many places from the end (Google's external LB: 2); 0 = the
# socket peer (development: nothing in front).
TARN_RATE_LIMITS_ENABLED=true
TARN_TRUSTED_PROXY_HOPS=0
# Sessions: access token minutes; refresh cookie hours, or days with "Remember session".
TARN_ACCESS_TOKEN_MINUTES=15
TARN_SESSION_HOURS=12
TARN_REMEMBER_SESSION_DAYS=30
# Links in emails point here (production: https:// only). The console mailer prints emails to
# the log (development only).
TARN_PUBLIC_URL=http://localhost:5173
# console prints emails to the log (development only; production refuses it); smtp sends
# through any SMTP server (STARTTLS, or TLS on port 465). The password: TARN_SMTP_PASSWORD, or
# with TARN_SECRETS_BACKEND=gcp the Secret Manager secret tarn-smtp-password.
TARN_MAILER=console
TARN_SMTP_HOST=
TARN_SMTP_PORT=587
TARN_SMTP_USER=
TARN_SMTP_PASSWORD=
TARN_SMTP_FROM=
# Cloud Run job entry (python -m tarn_worker.job): ends after the queue has been empty this
# many seconds (0 = at once), or after this many seconds in all.
TARN_WORKER_JOB_IDLE_SECONDS=0
TARN_WORKER_JOB_MAX_SECONDS=3300
# New tenants wait for a Tarn operator (`tarn tenants approve`) after email verification.
TARN_TENANT_SIGNUP_REQUIRES_APPROVAL=true
# The worker answers GET /health on this port (0 = off); the API reports it in the status pill
# of the web app by calling the URL (empty = shown as "unknown"). Compose sets both.
TARN_WORKER_HEALTH_HOST=127.0.0.1
TARN_WORKER_HEALTH_PORT=8001
TARN_WORKER_HEALTH_URL=
# Encrypted identity backups written by the worker (0 hours = off); newest N kept per tenant.
TARN_IDENTITY_BACKUP_DIR=../var/backups/identity
TARN_IDENTITY_BACKUP_INTERVAL_HOURS=24
TARN_IDENTITY_BACKUP_KEEP=14

# --- PostgreSQL 16 + pgvector (Compose service "postgres") -------------------------------
POSTGRES_USER=tarn
POSTGRES_PASSWORD=tarn_dev_password
POSTGRES_DB=tarn
POSTGRES_PORT=5432
# Password of the application role inside Compose; keep it equal to TARN_APP_DATABASE_URL's.
TARN_APP_DB_PASSWORD=tarn_app_dev_password

# --- MinIO (Compose service "minio"; local storage only) ---------------------------------
MINIO_ROOT_USER=tarn_dev_minio
MINIO_ROOT_PASSWORD=tarn_dev_minio_password
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Published ports (all bound to 127.0.0.1) --------------------------------------------
API_PORT=8000
FRONTEND_PORT=5173

# --- Upload, page cleaning and the job queue (P9) -----------------------------------------
# A teacher may have this many booklets queued or being processed at once.
TARN_MAX_QUEUED_BOOKLETS_PER_TEACHER=5
# Upload limits: total bytes of one booklet's files, and files (or PDF pages) per booklet.
TARN_UPLOAD_MAX_BYTES=104857600
TARN_UPLOAD_MAX_PAGES=40
# Cleaned pages: longest side in pixels, and file size in bytes, at most.
TARN_PAGE_MAX_EDGE_PX=2200
TARN_PAGE_MAX_BYTES=800000
# Quality gate (placeholders until teacher-marked ground truth exists; see CLAUDE.md).
TARN_QUALITY_MIN_SHARPNESS=130
TARN_QUALITY_MAX_GLARE_SHARE=0.06
TARN_QUALITY_MIN_PAGE_EDGE_PX=500
# Job queue: attempts per job, seconds a worker may stay silent before its job is handed out
# again, first retry backoff (doubles each attempt), and how often an idle worker looks.
TARN_JOB_MAX_ATTEMPTS=3
TARN_JOB_LEASE_SECONDS=120
TARN_JOB_BACKOFF_SECONDS=5
TARN_WORKER_POLL_SECONDS=2

# --- The review (P15) ---------------------------------------------------------------------
# Minutes a booklet stays locked to the teacher who opened it after their last change.
TARN_BOOKLET_LOCK_MINUTES=15
