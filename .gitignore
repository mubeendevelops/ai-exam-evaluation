# ──────────────────────────────────────────────
# Python
# ──────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
venv/
.venv/
.venv-paddleocr/
env/
ENV/

# Local DB dumps/backups (pg_dump before destructive resets, etc.)
db_backups/

# Distribution / packaging
*.egg-info/
*.egg
dist/
build/
wheels/

# ──────────────────────────────────────────────
# Secrets & environment
# ──────────────────────────────────────────────
.env
.env.local
.env.*.local

# ──────────────────────────────────────────────
# Extracted / generated data
# ──────────────────────────────────────────────
# Output of extract_exam_bank.py (JSON + images).
# Re-generate locally with: python3 scripts/extract_exam_bank.py exam\ bank.docx --outdir ./extracted
extracted/

# Build output of scripts/evaluate_booklet.py / ingest_booklet.py's --output
# flag (neither has a default path — this file was committed by someone
# running `--output report.json` from the repo root). Not a source file or a
# fixture; regenerate with --offline --stub if you need one to look at.
/report.json

# Source binary — too large for Git, keep in shared drive / object storage
exam bank.docx

# ──────────────────────────────────────────────
# IDE / editor
# ──────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ──────────────────────────────────────────────
# OS junk
# ──────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ──────────────────────────────────────────────
# Docker (local data volumes, not config)
# ──────────────────────────────────────────────
docker-data/
minio-data/

# ──────────────────────────────────────────────
# Misc
# ──────────────────────────────────────────────
*.log
*.bak

# ──────────────────────────────────────────────
# Documentation, research, design
# ──────────────────────────────────────────────
# All markdown and PDF files in these directories are
# research artifacts, not code. They should not be in
# the Python package index, nor are they artifacts
# expected to be present when running the server/UI.

/docs/*
/research/*
readme files/
CLAUDE_CONTEXT.md
plan.md
claude_code_roadmap_prompts.md

# ──────────────────────────────────────────────
# Test tooling
# ──────────────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ──────────────────────────────────────────────
# Local agent/tooling state
# ──────────────────────────────────────────────
# Claude Code per-checkout session state (locks, scheduled tasks) — local,
# not project config. NOTE: media/ocr_benchmark/, media/tables/,
# media/diagram_benchmark/ and media/booklets/ are deliberately NOT ignored:
# they look like generator output but are the committed labelled fixture sets
# that scripts/benchmark_ocr_engines.py,
# scripts/benchmark_diagram_extraction.py and
# scripts/benchmark_booklet_segmentation.py score against. media/booklets/
# also holds sample_booklet.pdf — the only PDF in this repo, and the only
# input scripts/ingest_booklet.py can be verified on.
.claude/
rough_edges.txt
# ──────────────────────────────────────────────
# Excluded from the shared/review tree (2026-09-12)
# ──────────────────────────────────────────────
# Student answer booklets — real submissions with apparent names and roll
# numbers in the filenames. NEVER commit these; they are PII, not fixtures.
# The sample booklet the code is actually verified against is
# media/booklets/sample_booklet.pdf.
/booklets/

# Tests and test/benchmark fixture sets. NOTE: this supersedes the note
# further up that deliberately did NOT ignore media/* — the fixture sets are
# still the labelled data the benchmark scripts score against, they are just
# no longer tracked here.
/tests/
/pytest.ini
/media/

# Dev/CI tooling
/Makefile
/.github/
/frontend/.oxlintrc.json
/frontend/scripts/

# Generated internal docs — written for the coding agent, not for an
# operator or end user.
CLEANUP_AUDIT.md
ARCHITECTURE.md
CLEANUP_SUMMARY.md

# Offline benchmark + demo tooling (fixture generators, engine scorers, and
# the two hardcoded-id demo shells). Not part of the production pipeline —
# CLAUDE_CONTEXT.md §4 says so explicitly for the OCR/diagram/table sets.
/scripts/generate_ocr_benchmark.py
/scripts/benchmark_ocr_engines.py
/scripts/generate_diagram_benchmark.py
/scripts/benchmark_diagram_extraction.py
/scripts/generate_table_benchmark.py
/scripts/generate_booklet_benchmark.py
/scripts/benchmark_booklet_segmentation.py
/scripts/run_diagram_eval_demo.sh
/scripts/run_table_eval_demo.sh
