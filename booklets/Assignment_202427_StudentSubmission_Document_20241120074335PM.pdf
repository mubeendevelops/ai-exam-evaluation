            function CheckMenu() {
                var MenuData = localStorage.getItem('Menu');
                if (MenuData != null)
                    document.getElementById("ctl00_MenuUL").innerHTML = MenuData;

            }


            function FillMenu() {

                var MenuData = localStorage.getItem('Menu');
                if (MenuData != null) {
                    document.getElementById("ctl00_MenuUL").innerHTML = MenuData;
                    myFunction('0');
                }
                else {
                    $.ajax({
                        type: "post",
                        url: "https://ums.mydsi.org/WS/FillMenu.asmx/FillMenuByUserID",
                        data: "{ UserID: '" + 3299 + "', RoleID: '" + 3 + "'}",
                        contentType: "application/json; charset=utf-8",
                        dataType: "json",

                        success: function (r) {
                            if (r.d != undefined) {
                                localStorage.setItem('Menu', r.d);
                                CheckMenu();
                            }
                            else {
                                alert("Try after sometime");
                            }
                        },
                        error: function (r) {
                            //alert("error");
                            //alert(r.responseText);
                        }
                    });
                }

                var pathname = window.location.pathname; // Returns path only
                var url = window.location.href

                var ActiveURL = 0;

                $("#ctl00_MenuUL li >ul > li > a").each(function () {
                    var h = $(this).attr("href");
                    if (h == url) {
                        $(this).closest('li').addClass("active");

                        $(this).parent().parent().parent().addClass("active open");

                        if ($(this).parent().parent().parent().parent().parent() != undefined)
                            $(this).parent().parent().parent().parent().parent().addClass("active open");

                        ActiveURL = 1;
                    }



                });

                $("#ctl00_MenuUL li > ul > li > ul > li > a").each(function () {
                    var h = $(this).attr("href");
                    if (h == url) {
                        $(this).closest('li').addClass("active");

                        $(this).parent().parent().parent().parent().parent().parent().addClass("active open");

                        if ($(this).parent().parent().parent().parent().parent().parent().parent() != undefined)
                            $(this).parent().parent().parent().parent().parent().parent().parent().addClass("active open");
                        ActiveURL = 1;
                    }

                });

                $("#ctl00_MenuUL li > a").each(function () {
                    var h = $(this).attr("href");
                    if (h == url) {
                        $(this).parent().addClass("active open");
                        ActiveURL = 1;
                    }
                });


                //////
                if (parseInt(ActiveURL) == 0) {

                    $("#ctl00_MenuUL li >ul > li > a").each(function () {
                        var h = $(this).attr("href");
                        var PageFolderURL = url.substring(0, url.lastIndexOf("/") + 1);
                        var MenuFolderURL = h.substring(0, h.lastIndexOf("/") + 1);

                        if (PageFolderURL == MenuFolderURL && ActiveURL == 0) {
                            //  $(this).closest('li').addClass("active open 5");
                            //$(this).parent().addClass("active open 3");

                            $(this).parent().parent().parent().addClass("active open 1");

                            if ($(this).parent().parent().parent().parent().parent() != undefined)
                                $(this).parent().parent().parent().parent().parent().addClass("active open 4");
                            ActiveURL = 1;
                        }


                    });


                }




                
            }

            jQuery(document).ready(function () {
