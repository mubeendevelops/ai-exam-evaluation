                        </div>
                        <div class="arrow-down border-top-blue-soft"></div>
                        <div class="price-table-pricing">
                            <span>
                                <h3 style="margin-top: 10px">
                                    <span id="lblAppRegistrationNo_Modal" class="bold" style="color: #45b6af">
