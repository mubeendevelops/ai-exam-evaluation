    <script>
        function CountChecked() {
            var TotalCount = ($(".group-checkable").length - 1);
            var CheckedCount = $(".gridCheckBox input:checked").length;
            var NotCheckedCount = (parseInt(TotalCount) - parseInt(CheckedCount));
            $('#ctl00_cphPageContent_lblSelectedCount').html(CheckedCount);
            $('#ctl00_cphPageContent_lblNotSelectedCount').html(NotCheckedCount);
        }
        function ViewPDFModal(url, Title) {
            $('#PDFModal').modal('show');
            document.getElementById("iPDF").src = url + "#toolbar=0&navpanes=0";
            document.getElementById("ctl00_cphPageContent_lblPDFTitle").innerText = Title;
        }
        $(document).keyup(function (e) {
            if (e.keyCode == 27) {
                ;
                $("#CloseButton").trigger("click");
            }
