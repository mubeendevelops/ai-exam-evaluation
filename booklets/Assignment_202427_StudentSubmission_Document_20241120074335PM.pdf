            function RedirectToFeedBackPopup() {
                var URLName = window.location.href;
                var PageName = URLName.split("/").pop();
                var PagePath = "/AdminPanel/Security/SEC_PageFeedback/SEC_PageFeedback_FromFooter.aspx" + "?PageURL=" + URLName + "&PageName=" + PageName;
                var link = document.getElementById("ctl00_hlFeedbackPopup");
                link.href = PagePath;
            }

           

            function myFunction(IsType) {
                input = document.getElementById("ctl00_mySearch");

                var filter = "";
                if (IsType == "1") {
                    filter = input.value.toUpperCase();
                    localStorage.setItem('MenuFilter', filter);
                }
                else {
                    var MenuFilterData = localStorage.getItem('MenuFilter');
                    if (MenuFilterData != null) {
                        document.getElementById("ctl00_mySearch").value = MenuFilterData;
                        filter = MenuFilterData;
                    }
                }


                $('#ctl00_MenuUL >li').each(function () {
                    var text = $(this).text().toLowerCase();
                    if (text.toUpperCase().indexOf(filter) >= 0 || $(this).html().toUpperCase().indexOf(filter) >= 0 || $(this).hasClass("sidebar-toggler-wrapper")) {
                        $(this).show();
                        $(this).children().toggleClass("active open");
                    } else {
                        $(this).hide();
                    }
                });

                $('#ctl00_MenuUL > li > ul > li').each(function () {
                    var text = $(this).text().toLowerCase();
                    if (text.toUpperCase().indexOf(filter) >= 0 || $(this).html().toUpperCase().indexOf(filter) >= 0) {
                        $(this).show();
                        $(this).children().toggleClass("active open");
                    } else {
                        $(this).hide();
                    }
                });

                $('#ctl00_MenuUL > li > ul > li > ul > li').each(function () {
                    var text = $(this).text().toLowerCase();
                    if (text.toUpperCase().indexOf(filter) >= 0 || $(this).html().toUpperCase().indexOf(filter) >= 0) {
                        $(this).show();
                        $(this).children().toggleClass("active open");
                    } else {
                        $(this).hide();
                    }
                });
            }

            function GNHTMLPrint(PageHeader) {

                var x = screen.width / 2 - 1000 / 2;
                var y = screen.height / 2 - 550 / 2;
                var strDomainURL = '';

                //var data = document.getElementsByClassName("GNHTMLPrint")[0].innerHTML;

                window.open(strDomainURL + '/Default/HTMLPrint.aspx', "myWindow", 'width=800,height=800,left=' + x + ',top=' + y);   // Opens a new window
                //window.onafterprint = window.history.back();
                //window.location.replace(window.location.href);
                //mywindow.document.write('<html><head><title>' + PageHeader + '</title>');
                //mywindow.document.write('</head><body >');
                //mywindow.document.write(data);
                //mywindow.document.write('</body></html>');
                //mywindow.print();
                //mywindow.close();
                //event.preventDefault();
                return true;
            }

            function HTMLPrintStudentCertificate(StudentCertificateRequestID, Isheader) {

                var x = screen.width / 2 - 1000 / 2;
                var y = screen.height / 2 - 550 / 2;
                var strDomainURL = '';
                var mywindow = window.open(strDomainURL + '/Default/HTMLPrintStudentCertificate.aspx?StudentCertificateRequestID=' + StudentCertificateRequestID + '&Isheader=' + Isheader, "myWindow", 'width=1000,height=600,left=' + x + ',top=' + y);   // Opens a new window
                //window.open(strDomainURL + '/Default/HTMLPrintStudentCertificate.aspx?StudentCertificateRequestID=' + StudentCertificateRequestID + '&Isheader=' + Isheader, "myWindow", 'width=800,height=800,left=' + x + ',top=' + y);   // Opens a new window
                return true;
            }

            function ScrolltoTop(Control) {
                ScrollToSearch(Control);
